<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/service_fee_change_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/service_fee_change_scope"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgFeeKind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_fee_default" />

        <RadioButton
            android:id="@+id/rbManualPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/percentage" />

        <RadioButton
            android:id="@+id/rbManualValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fixed_value" />

        <RadioButton
            android:id="@+id/rbWaived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_fee_exempt" />
    </RadioGroup>

    <EditText
        android:id="@+id/etManualValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="@string/value_or_percentage"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apply"
        android:layout_marginTop="16dp" />

    <ProgressBar
        android:id="@+id/progressApply"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
