<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Operação precisa de atenção"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mesa 12"
        android:textColor="#D32F2F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailOperation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Operação: Abrir mesa"
        android:textColor="#616161"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDetailTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tentativa: Hoje, 13:42"
        android:textColor="#757575"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFF8E1"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#FFE082"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O que aconteceu"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A comunicação foi interrompida e não foi possível determinar com segurança se a operação foi concluída."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="O que deseja fazer?"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Button R-A: Confirm Remote Success -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Já foi concluída"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="#388E3C"
        app:cornerRadius="8dp" />

    <!-- Button R-B: Retry -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tentar novamente"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp" />

    <!-- Button R-C: Cancel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelOperation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cancelar operação"
        android:textAllCaps="false"
        android:textColor="#D32F2F"
        app:backgroundTint="@color/white"
        app:cornerRadius="8dp"
        app:strokeColor="#D32F2F"
        app:strokeWidth="1dp" />

</LinearLayout>
