<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <!-- Ícone Informativo / Atenção -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_credit_card"
        app:tint="#F57C00" />

    <!-- Título: Não conseguimos confirmar este pagamento -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Não conseguimos confirmar este pagamento"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Card de Alerta Destacado: O cartão pode ter sido cobrado -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFF3E0"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#FFE0B2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ O cartão pode ter sido cobrado. Consulte antes de tentar novamente."
                android:textColor="#E65100"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAttemptDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#795548"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Ação 1: Consultar de novo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetryCheck"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#F57C00"
        android:text="Consultar de novo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <!-- Ação 2: Registrar como pendente e resolver depois -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkPending"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="Registrar como pendente e resolver depois"
        android:textAllCaps="false"
        android:textColor="#37474F"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:strokeColor="#90A4AE" />

    <!-- Ação 3: Ver comprovante do app de pagamento -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewReceipt"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Ver comprovante do app de pagamento"
        android:textAllCaps="false"
        android:textColor="#1976D2"
        android:textSize="14sp" />

</LinearLayout>
