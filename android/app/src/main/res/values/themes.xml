<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartPosPdvPro" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.SmartPos.Card</item>
        <item name="materialButtonStyle">@style/Widget.SmartPos.Button</item>
    </style>

    <style name="Widget.SmartPos.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.SmartPos.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="Theme.SmartPosPdvPro.Transparent" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
